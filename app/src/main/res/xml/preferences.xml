<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory android:title="@string/pref_category_service">
        <SwitchPreferenceCompat
            android:key="feature_enabled"
            android:title="@string/pref_enable_title"
            android:summary="@string/pref_enable_summary"
            android:defaultValue="true" />

        <SwitchPreferenceCompat
            android:key="accessibility_status"
            android:title="@string/pref_accessibility_title"
            android:summary="@string/pref_accessibility_summary"
            android:persistent="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_transcription">
        <Preference
            android:key="offline_model_choice"
            android:title="@string/pref_offline_model" />

        <SwitchPreferenceCompat
            android:key="auto_finish_speech"
            android:title="@string/pref_auto_finish_title"
            android:summary="@string/pref_auto_finish_summary"
            android:defaultValue="false" />

        <EditTextPreference
            android:key="custom_dictionary"
            android:title="@string/pref_dictionary_title"
            android:dialogTitle="@string/pref_dictionary_title"
            android:dialogMessage="@string/pref_dictionary_message"
            android:summary="@string/pref_dictionary_summary"
            android:defaultValue="" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_output">
        <ListPreference
            android:key="no_input_action"
            android:title="@string/pref_no_input_title"
            android:dialogTitle="@string/pref_no_input_title"
            android:entries="@array/no_input_action_entries"
            android:entryValues="@array/no_input_action_values"
            android:defaultValue="clipboard"
            android:summary="%s" />

        <EditTextPreference
            android:key="termux_script_path"
            android:title="@string/pref_termux_path_title"
            android:dialogTitle="@string/pref_termux_path_title"
            android:dialogMessage="@string/pref_termux_path_message"
            android:defaultValue="" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/pref_category_floating_button">
        <ListPreference
            android:key="floating_button_size"
            android:title="@string/pref_button_size_title"
            android:dialogTitle="@string/pref_button_size_title"
            android:entries="@array/floating_button_size_entries"
            android:entryValues="@array/floating_button_size_values"
            android:defaultValue="normal"
            android:summary="%s" />

        <com.ross.speechtotext.ButtonColorPreference
            android:key="floating_button_color"
            android:title="@string/pref_button_color_title"
            android:defaultValue="primary" />
    </PreferenceCategory>
</PreferenceScreen>
