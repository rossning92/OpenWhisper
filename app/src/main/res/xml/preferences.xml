<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <SwitchPreferenceCompat
        android:key="feature_enabled"
        android:title="Enable Speech To Text"
        android:summary="Show the floating dictation button and run at startup"
        android:defaultValue="true" />

    <PreferenceCategory android:title="Provider">
        <EditTextPreference
            android:key="openai_api_key"
            android:title="OpenAI API Key"
            android:dialogTitle="OpenAI API Key"
            android:singleLine="true" />
        <ListPreference
            android:key="transcription_mode"
            android:title="Transcription mode"
            android:dialogTitle="Transcription mode"
            android:entries="@array/transcription_mode_entries"
            android:entryValues="@array/transcription_mode_values"
            android:defaultValue="realtime"
            android:summary="%s" />
        <EditTextPreference
            android:key="transcription_prompt"
            android:title="Transcription prompt"
            android:dialogTitle="Transcription prompt"
            android:dialogMessage="This text is sent directly to the transcription model to provide language, vocabulary, spelling, punctuation, or formatting guidance."
            android:defaultValue="@string/default_transcription_prompt"
            android:summary="Customize transcription instructions and context"
            android:singleLine="false" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Recording">
        <ListPreference
            android:key="audio_bitrate"
            android:title="Audio quality"
            android:dialogTitle="Audio quality"
            android:entries="@array/audio_bitrate_entries"
            android:entryValues="@array/audio_bitrate_values"
            android:defaultValue="24000"
            android:summary="%s" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Floating Control">
        <ListPreference
            android:key="floating_button_size"
            android:title="Button size"
            android:dialogTitle="Button size"
            android:entries="@array/floating_button_size_entries"
            android:entryValues="@array/floating_button_size_values"
            android:defaultValue="normal"
            android:summary="%s" />
    </PreferenceCategory>

    <PreferenceCategory android:title="Text Input">
        <SwitchPreferenceCompat
            android:key="accessibility_status"
            android:title="Accessibility Service"
            android:summary="Types dictated text into focused fields. When enabled, the floating control uses a trusted accessibility overlay so protected screens, such as browser permission prompts, remain usable. When disabled, the control uses Draw over other apps instead."
            android:persistent="false" />
    </PreferenceCategory>
</PreferenceScreen>
