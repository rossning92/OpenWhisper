    <string name="pref_accessibility_title">Accessibility Service</string>
    <string name="pref_accessibility_summary">Types dictated text into focused fields. When enabled, the floating control uses a trusted accessibility overlay so protected screens, such as browser permission prompts, remain usable. When disabled, the control uses Draw over other apps instead.</string>
