    <string name="pref_dictionary_title">Custom dictionary</string>
    <string name="pref_dictionary_message">One word or phrase per line, most important first. Qwen3-ASR uses these as spelling hints. Clear the list to turn it off.</string>
    <string name="pref_dictionary_summary">Names and technical terms for Qwen3-ASR only; not used by Parakeet</string>
