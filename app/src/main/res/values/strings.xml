    <string name="app_name">Open Whisper</string>
    <string name="accessibility_description">Allows Open Whisper to type transcribed text into focused fields and show its floating dictation control as an accessibility overlay. This keeps protected screens, such as browser permission prompts, usable while the control is visible.</string>
